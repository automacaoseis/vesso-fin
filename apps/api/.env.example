# Pooler do Supabase em transaction mode (porta 6543), login vesso_fin_api — a senha é definida à mão em produção.
DATABASE_URL=postgres://vesso_fin_api.gzdvkqzliyupiuyaqkpj:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# PEM do CA (Settings → Database → SSL Configuration). Sem ele, a conexão não verifica o certificado.
DATABASE_CA=
# Só para JWKS e issuer. A API não usa a REST do Supabase nem service_role.
SUPABASE_URL=https://gzdvkqzliyupiuyaqkpj.supabase.co
# Mesmo valor no apps/web. Gerar com: openssl rand -hex 32
VESSO_SERVICE_SECRET=
PORT=8080

# ── Worker (mesmo pacote, outro serviço na Railway: `pnpm --filter @vesso-fin/api worker`) ──
# Login vesso_fin_worker: escreve SÓ bronze, prata e jobs. Senha definida à mão em produção.
DATABASE_URL_WORKER=postgres://vesso_fin_worker.gzdvkqzliyupiuyaqkpj:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
INTERVALO_MS=2000
# Asaas: a CHAVE não vai aqui — fica no Vault (conexoes.id_segredo). Só a URL, para apontar o sandbox se preciso.
ASAAS_BASE_URL=https://api.asaas.com/v3
