{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @vesso-fin/api build",
    "watchPatterns": [
      "apps/api/**",
      "packages/shared/**",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "node --enable-source-maps apps/api/dist/worker.js",
    "restartPolicyType": "ALWAYS"
  }
}
